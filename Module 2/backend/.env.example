# AI engine: yolo (recommended) or edge (lightweight OpenCV fallback)
PARKING_DETECTOR=yolo

# Optional: local model weights path. Default yolov8n.pt downloads on first run.
# YOLO_MODEL=yolov8n.pt

# Optional database URL. Default is SQLite in backend/parking.db.
# PARKING_DATABASE_URL=postgresql://username:password@localhost:5432/parking_db

# Detection tuning for the edge fallback only
# PARKING_EDGE_THRESHOLD=0.015
# PARKING_ROI_MARGIN_RATIO=0.08
